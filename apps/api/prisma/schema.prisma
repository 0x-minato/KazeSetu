// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum SwapStatus {
  SUCCESS
  PENDING
  FAILED
}

enum LiquidityEventType {
  ADD
  REMOVE
}

enum StakingEventType {
  STAKE
  UNSTAKE
  CLAIM
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallets         Wallet[]
  refreshSessions RefreshSession[]
  role            Role                @default(USER)
  swaps           Swap[]
  liquidity       LiquidityPosition[]
  liquidityEvent  LiquidityEvent[]
  stakingPosition StakingPosition[]
  stakingEvent    StakingEvent[]

  @@map("users")
}

model Wallet {
  id        String   @id @default(cuid())
  address   String   @unique
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balances WalletBalance[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallet")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  sessionId String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  session RefreshSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_token")
}

model RefreshSession {
  id        String    @id @default(cuid())
  userId    String
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  expiresAt DateTime

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_session")
}

model Token {
  id        String   @id @default(cuid())
  address   String
  chainId   Int
  name      String
  symbol    String
  decimals  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  price           TokenPrice?
  balances        WalletBalance[]
  stakingFarms    StakingFarm[]
  poolsAsToken0   Pool[]          @relation("PoolToken0")
  poolsAsToken1   Pool[]          @relation("PoolToken1")
  swapsAsTokenIn  Swap[]          @relation("SwapTokenIn")
  swapsAsTokenOut Swap[]          @relation("SwapTokenOut")

  @@unique([chainId, address])
  @@map("tokens")
}

model TokenPrice {
  id        String   @id @default(cuid())
  tokenId   String   @unique
  priceUsd  Decimal  @db.Decimal(36, 18)
  updatedAt DateTime @updatedAt

  token Token @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@map("token_price")
}

model WalletBalance {
  id        String   @id @default(cuid())
  walletId  String
  tokenId   String
  amount    Decimal  @db.Decimal(36, 18)
  updatedAt DateTime @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  token  Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([walletId, tokenId])
  @@index([walletId])
  @@index([tokenId])
  @@map("wallet_balances")
}

model Pool {
  id        String   @id @default(cuid())
  address   String
  chainId   Int
  token0Id  String
  token1Id  String
  feeBps    Int
  reserve0  Decimal  @db.Decimal(36, 18)
  reserve1  Decimal  @db.Decimal(36, 18)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  token0 Token @relation("PoolToken0", fields: [token0Id], references: [id], onDelete: Cascade)
  token1 Token @relation("PoolToken1", fields: [token1Id], references: [id], onDelete: Cascade)

  swaps          Swap[]
  liquidity      LiquidityPosition[]
  liquidityEvent LiquidityEvent[]
  stakingFarms   StakingFarm[]

  @@unique([chainId, address])
  @@index([token0Id])
  @@index([token1Id])
  @@map("pools")
}

model Swap {
  id         String     @id @default(cuid())
  userId     String
  chainId    Int
  poolId     String
  tokenInId  String
  tokenOutId String
  amountIn   Decimal    @db.Decimal(36, 18)
  amountOut  Decimal    @db.Decimal(36, 18)
  txHash     String?
  status     SwapStatus @default(PENDING)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  pool     Pool  @relation(fields: [poolId], references: [id], onDelete: Cascade)
  tokenIn  Token @relation("SwapTokenIn", fields: [tokenInId], references: [id], onDelete: Cascade)
  tokenOut Token @relation("SwapTokenOut", fields: [tokenOutId], references: [id], onDelete: Cascade)

  @@unique([chainId, txHash])
  @@index([userId])
  @@map("swaps")
}

model LiquidityPosition {
  id            String   @id @default(cuid())
  userId        String
  poolId        String
  chainId       Int
  lpTokenAmount Decimal  @db.Decimal(36, 18)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@unique([userId, poolId])
  @@index([userId])
  @@map("liquidity_positions")
}

model LiquidityEvent {
  id        String             @id @default(cuid())
  userId    String
  poolId    String
  chainId   Int
  type      LiquidityEventType
  amount0   Decimal            @db.Decimal(36, 18)
  amount1   Decimal            @db.Decimal(36, 18)
  lpAmount  Decimal            @db.Decimal(36, 18)
  txHash    String?
  status    SwapStatus         @default(PENDING)
  createdAt DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pool Pool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@unique([chainId, txHash])
  @@index([userId])
  @@map("liquidity_events")
}

model StakingFarm {
  id            String   @id @default(cuid())
  address       String
  chainId       Int
  poolId        String
  rewardTokenId String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pool        Pool  @relation(fields: [poolId], references: [id], onDelete: Cascade)
  rewardToken Token @relation(fields: [rewardTokenId], references: [id], onDelete: Cascade)

  positions StakingPosition[]
  events    StakingEvent[]

  @@unique([chainId, address])
  @@index([poolId])
  @@index([rewardTokenId])
  @@map("staking_farms")
}

model StakingPosition {
  id           String   @id @default(cuid())
  userId       String
  farmId       String
  chainId      Int
  stakedAmount Decimal  @db.Decimal(36, 18)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm StakingFarm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([userId, farmId])
  @@index([userId])
  @@map("staking_positions")
}

model StakingEvent {
  id        String           @id @default(cuid())
  userId    String
  farmId    String
  chainId   Int
  type      StakingEventType
  amount    Decimal          @db.Decimal(36, 18)
  txHash    String?
  status    SwapStatus       @default(PENDING)
  createdAt DateTime         @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  farm StakingFarm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([chainId, txHash])
  @@index([userId])
  @@map("staking_events")
}
