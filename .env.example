# ============================================================================
# KazeSetu — Root / Docker Compose Environment Template
# ============================================================================

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=KazeSetu
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/KazeSetu?schema=public

# --- Redis (BullMQ Queue Broker) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Express API (apps/api) ---
NODE_ENV=development
PORT=3001
SIWE_DOMAIN=localhost:5173
SIWE_URI=http://localhost:5173
SIWE_ALLOWED_CHAIN_IDS=1,11155111,8453,42161,137,31337
JWT_ACCESS_SECRET=change-me-to-a-32-byte-high-entropy-secret
ADMIN_ADDRESS=0x0000000000000000000000000000000000000000
WORKER_API_KEY=kazesetu-internal-worker-secret

# --- Next.js Web Terminal (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Blockchain Event Indexer (apps/indexer) & Worker (apps/worker) ---
RPC_URL=https://ethereum-rpc.publicnode.com
RPC_URL_1=https://ethereum-rpc.publicnode.com
RPC_URL_11155111=https://ethereum-sepolia-rpc.publicnode.com
RPC_URL_8453=https://mainnet.base.org
RPC_URL_42161=https://arb1.arbitrum.io/rpc
POLL_INTERVAL_MS=10000
STATE_SYNC_INTERVAL_MS=60000
MAX_BLOCK_RANGE=2000n
START_BLOCK_OFFSET=100n
